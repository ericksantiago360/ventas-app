# Copiar a .env y ajustar valores
MONGODB_URL=mongodb://mongo:27017
MONGODB_DB=ventas
SECRET_KEY=cambia-esto-por-una-clave-aleatoria-de-al-menos-32-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEBUG=false
STORAGE_PATH=/app/storage

# URL pública de la app (se usa en los enlaces del portal del paciente)
APP_URL=https://lab.midominio.com

# Correo saliente para envío de resultados (ej. Gmail: smtp.gmail.com, 587, contraseña de aplicación)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=
SMTP_SSL=false

# Vigencia en días de los enlaces de acceso al portal del paciente
PORTAL_TOKEN_DAYS=30
